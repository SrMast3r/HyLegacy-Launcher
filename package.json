{
  "name": "hyl-client",
  "productName": "HyLegacy Client",
  "version": "2.1.8",
  "description": "",
  "main": "src/app.js",
  "author": {
    "name": "HyLegacy LLC",
    "email": "account@hylegacy.com",
    "url": "https://www.hylegacy.com/"
  },
  "scripts": {
    "start": "cross-env-shell NODE_ENV=dev electron .",
    "dev": "cross-env-shell DEV_TOOL=open nodemon --exec npm start",
    "build": "node build.js --obf=true --build=platform"
  },
  "license": "CCANC",
  "dependencies": {
    "electron-updater": "^6.1.8",
    "minecraft-java-core": "^4.1.7",
    "node-bdd": "^2.0.4",
    "node-fetch": "^2.7.0",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^26.0.12",
    "javascript-obfuscator": "^4.1.0",
    "jimp": "^0.22.12",
    "nodemon": "^3.1.2",
    "png2icons": "^2.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SrMast3r/HyLegacy-Launcher.git"
  },
  "build": {
    "appId": "com.hylegacy.client",
    "productName": "HyLegacy Client",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "asar": true,
    "artifactName": "${name}-${version}.${ext}",
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true },
    "publish": [
      { "provider": "github", "owner": "SrMast3r", "repo": "HyLegacy-Launcher" }
    ]
  }
}
